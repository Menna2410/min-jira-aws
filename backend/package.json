    "@aws-sdk/client-sns": "^3.826.0",
    "@aws-sdk/lib-dynamodb": "^3.826.0",
    "@aws-sdk/s3-request-presigner": "^3.826.0",
    "aws-jwt-verify": "^5.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
