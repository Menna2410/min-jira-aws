PORT=4000

AWS_REGION=us-east-1



COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx

COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx



# Table names (match your AWS console)

DYNAMO_TABLE_TEAMS=Teams

DYNAMO_TABLE_USERS=Users

DYNAMO_TABLE_PROJECTS=Projects

DYNAMO_TABLE_TASKS=Tasks

DYNAMO_TABLE_COMMENTS=Comments

DYNAMO_TABLE_TASK_AUDIT=TaskAudit



# Global secondary indexes — values must match the *index name* in DynamoDB exactly.

# Projects table: GSI partition key attribute = TeamID (String)

PROJECTS_GSI_TEAM_ID=PROJECTS_GSI_TEAM_ID

# Tasks table: GSIs with partition keys TeamID and AssigneeUserId on each item

TASKS_GSI_TEAM_ID=TASKS_GSI_TEAM_ID

TASKS_GSI_ASSIGNEE_ID=TASKS_GSI_ASSIGNEE_ID



# Optional: only if your attribute names differ from the defaults

# DYNAMO_ATTR_TEAM_ID=TeamID

# DYNAMO_ATTR_USER_ID=UserID

# DYNAMO_ATTR_PROJECT_ID=ProjectID

# DYNAMO_ATTR_TASK_ID=TaskID

# DYNAMO_ATTR_COMMENT_PARTITION=TaskID

# DYNAMO_ATTR_COMMENT_SORT=CommentID

# DYNAMO_ATTR_AUDIT_PARTITION=TaskID

# DYNAMO_ATTR_AUDIT_SORT=AuditID



#

# Required table keys (if your tables differ, update the tables — keys cannot be changed on existing tables):

# - Teams:     PK = TeamID

# - Users:     PK = UserID

# - Projects:  PK = ProjectID  +  GSI named e.g. PROJECTS_GSI_TEAM_ID with PK = TeamID

# - Tasks:     PK = TaskID  +  GSIs TASKS_GSI_TEAM_ID (PK TeamID), TASKS_GSI_ASSIGNEE_ID (PK AssigneeUserId)

# - Comments:  PK = TaskID,     SK = CommentID   (comment thread per task)

# - TaskAudit: PK = TaskID,     SK = AuditID     (audit rows per task)

#



S3_ORIGINALS_BUCKET=mini-jira-task-images-originals

S3_UPLOAD_URL_TTL_SECONDS=3600



SNS_TASK_ASSIGNED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:mini-jira-task-assigned



CLOUDWATCH_NAMESPACE=MiniJira



# --- EC2 + ALB (no env vars for ELB — clients use the load balancer URL) ---

# On the instance: create /opt/mini-jira/.env with the values above. The SDK uses the

# instance role automatically — do not put access keys in .env unless required.

#

# - Target group: health check path /health (backend exposes GET /health)

# - Instance security group: allow inbound from the ALB security group on PORT (e.g. 4000)

# - ALB listener forwards HTTP/HTTPS to that port on the instance

# - Frontend / CloudFront calls https://YOUR-ALB-DNS/api/... (or your CloudFront domain)

#